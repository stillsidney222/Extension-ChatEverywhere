{
  "manifest_version": 3,
  "name": "Floating Chat",
  "version": "1.0",
  "description": "A floating chat button visible across all tabs",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
  "activeTab",
  "storage"
  ]
}
